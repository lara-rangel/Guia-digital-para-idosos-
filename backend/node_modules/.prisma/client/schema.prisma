generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Usuario {
  id             Int               @id @default(autoincrement())
  nome           String
  email          String            @unique
  idade          Int?
  senha          String
  nivel          String            @default("iniciante")
  pontuacao      Int               @default(0)
  aulasCompletas Int               @default(0)
  certificados   Int               @default(0)
  criadoEm       DateTime          @default(now())
  atualizadoEm   DateTime          @updatedAt
  progresso      ProgressoTrilha[]
}

model ProgressoTrilha {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  trilha      String
  aula        Int
  tituloAula  String
  concluida   Boolean  @default(true)
  concluidaEm DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, trilha, aula])
  @@index([usuarioId, trilha])
}
